# ========================================
# DATABASE CONFIGURATION
# ========================================
DATABASE_URL=sqlite:///./sih_db.sqlite

# ========================================
# BLOCKCHAIN CONFIGURATION (POLYGON)
# ========================================
# WARNING: NEVER commit your real private key. 
# Create a new test wallet for development.
POLYGON_PRIVATE_KEY=enter_your_64_character_private_key_here

# Contract Address after deployment
POLYGON_CONTRACT_ADDRESS=enter_your_deployed_contract_address_here

# RPC URL (Amoy Testnet)
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# ========================================
# JWT AUTHENTICATION
# ========================================
SECRET_KEY=enter_a_long_random_secret_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
